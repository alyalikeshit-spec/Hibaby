    local invGui = main:FindFirstChild("Inventory") or main:FindFirstChild("Fruits")
    if not invGui then return out, "no-Inventory" end

    local seen = {}
    for _, d in ipairs(invGui:GetDescendants()) do
        if d:IsA("ImageButton") or d:IsA("TextButton") then
            local name, src = extractNameFromGuiElement(d)
            if name then
                local key = norm(name)
                if key ~= "" and not seen[key] then
                    seen[key] = true
                    out[#out + 1] = { Name = name, Type = "Blox Fruit", Count = 1, _src = "gui:" .. tostring(src) }
                end
            end
        end
    end
    return out, "gui:" .. #out
end

-- ---------- 5.3 Backpack + Character tools ----------
local function invFromTools()
    local out = {}
    local function scan(container, label)
        if not container then return end
        for _, t in ipairs(container:GetChildren()) do
            if t:IsA("Tool") then
                local n = tostring(t.Name)
                if #n > 2 then
                    out[#out + 1] = { Name = n, Type = "Blox Fruit", Count = 1, _src = label }
                end
            end
        end
    end
    scan(LP:FindFirstChildOfClass("Backpack"), "backpack")
    scan(LP.Character, "held")
    return out, "tools:" .. #out
end

-- ---------- 5.4 Merge — SUM duplicates, do not drop ----------
local function mergeSources(sources)
    local merged, index = {}, {}
    for _, src in ipairs(sources) do
        for _, item in ipairs(src) do
            local key = norm(item.Name)
            if key ~= "" then
                if index[key] then
                    index[key].Count = (index[key].Count or 0) + (item.Count or 1)
                else
                    local copy = {
                        Name  = item.Name,
                        Type  = item.Type,
                        Count = item.Count or 1,
                        _src  = item._src,
                    }
                    merged[#merged + 1] = copy
                    index[key] = copy
                end
            end
        end
    end
    return merged
end

local function getInventory()
    local a, sa = invFromCommF()
    local b, sb = invFromPlayerGui()
    local c, sc = invFromTools()
    local merged = mergeSources({ a, b, c })
    if sa and sa ~= "none" then lastInvSource = sa end
    return merged, { CommF = sa, Gui = sb, Tools = sc }
end

-- ---------- 5.5 Classification — exact base name match, no raw substring ----------
local function classify(item)
    if not item then return "other" end
    local t = tostring(item.Type or ""):lower()
    if t == "blox fruit" or t:find("fruit", 1, true) then return "fruit" end
    if t == "premium" or t:find("perm", 1, true) or t:find("gamepass", 1, true) then return "premium" end

    local n = norm(item.Name)
    if n:find("fruit", 1, true) then return "fruit" end

    for _, kw in ipairs(KNOWN_FRUITS) do
        local nkw = norm(kw)
        -- Exact match OR the doubled pattern ("dragondragon" from "Dragon-Dragon")
        if n == nkw or n == nkw .. nkw then return "fruit" end
    end
    for _, kw in ipairs(SKIN_PRIORITY) do
        local nkw = norm(kw)
        if n:find(nkw, 1, true) then return "premium" end
    end
    return "other"
end

local function priorityRank(item)
    local n = norm(item.Name)
    for i, kw in ipairs(FRUIT_PRIORITY) do if n:find(norm(kw), 1, true) then return i end end
    for i, kw in ipairs(SKIN_PRIORITY) do if n:find(norm(kw), 1, true) then return 100 + i end end
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return 500 end
    if classify(item) == "fruit" then return 600 end
    return 999
end

local function collectTradeable()
    local inv = getInventory()
    local out = {}
    for _, item in ipairs(inv) do
        local cls = classify(item)
        if cls == "fruit" or cls == "premium" then out[#out + 1] = item end
    end
    table.sort(out, function(a, b) return priorityRank(a) < priorityRank(b) end)
    return out
end

