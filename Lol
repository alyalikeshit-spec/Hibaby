local function sayMessage(msg)
    if type(msg) ~= "string" or msg == "" then return end
    if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local ch = TextChatService.TextChannels and TextChatService.TextChannels.RBXGeneral
        if ch and ch.SendAsync then
            if pcall(function() ch:SendAsync(msg) end) then return end
        end
    end
    local events = RS:FindFirstChild("DefaultChatSystemChatEvents")
    local sayReq = events and events:FindFirstChild("SayMessageRequest")
    if sayReq then
        if pcall(function() sayReq:FireServer(msg, "All") end) then return end
    end
    pcall(function() LP:Chat(msg) end)
end

