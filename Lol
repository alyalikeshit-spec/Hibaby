-- 9. CHAT HOOK (TextChatService + Legacy)
-- =============================================================================
local function handleCommand(message)
    if type(message) ~= "string" or message:sub(1, 1) ~= CHAT_PREFIX then return end
    local body = message:sub(2)
    local cmd, args = body:match("^(%S+)%s*(.*)")
    if not cmd then return end
    cmd = cmd:lower()
    local fn = COMMANDS[cmd]
    if not fn then return end

    if cmd == "tp" then sayMessage("on my way bro !") else sayMessage("Working on it...") end

    task.spawn(function()
        pcall(fn, args)
    end)
end

Players.PlayerChatted:Connect(function(speaker, message)
    if isWhitelisted(speaker) then handleCommand(message) end
end)

pcall(function()
    local TextChatService = game:GetService("TextChatService")
    if TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local oldCallback = TextChatService.OnIncomingMessage
        TextChatService.OnIncomingMessage = function(message)
            if message.TextSource then
                local p = Players:GetPlayerByUserId(message.TextSource.UserId)
                if p and isWhitelisted(p) then
                    handleCommand(message.Text)
                end
            end
            if oldCallback then return oldCallback(message) else return Enum.TextChatMessageStatus.Success end
        end
    end
end)

LP.Chatted:Connect(handleCommand)

