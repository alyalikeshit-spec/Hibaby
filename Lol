-- =============================================================================
-- 9. CHAT — MessageId dedupe, single-fire
-- =============================================================================
local function isDuplicateMessage(message)
    if not message then return true end
    local id = message.MessageId
    if type(id) == "string" and #id > 0 then
        if seenMessageIds[id] then return true end
        seenMessageIds[id] = true
        task.delay(30, function() seenMessageIds[id] = nil end)
        return false
    end
    -- Fallback: key on speaker + text within a short window
    local speaker = message.TextSource and Players:GetPlayerByUserId(message.TextSource.UserId)
    local key = tostring(speaker and speaker.UserId or 0) .. "|" .. tostring(message.Text or "")
    if seenMessageIds[key] then return true end
    seenMessageIds[key] = true
    task.delay(2, function() seenMessageIds[key] = nil end)
    return false
end

local function handleCommand(message)
    if not message or not message.TextSource then return end
    if isDuplicateMessage(message) then return end
    local speaker = Players:GetPlayerByUserId(message.TextSource.UserId)
    if not isWhitelisted(speaker) then return end

    local text = tostring(message.Text or "")
    if text:sub(1, 1) ~= CHAT_PREFIX then return end
    local body = text:sub(2)
    local cmd, args = body:match("^(%S+)%s*(.*)")
    if not cmd then return end
    cmd = cmd:lower()
    local fn = COMMANDS[cmd]
    if not fn then return end

    -- Single ack, global cooldown, only for user-facing commands
    if cmd == "tp" or cmd == "sit" then
        sendAck("on my way bro !")
    elseif cmd == "addall" or cmd == "addallpre" or cmd == "addfruit" then
        sendAck("adding...")
    end

    task.spawn(function() pcall(fn, args) end)
end

-- Path A: OnIncomingMessage (TextChatService)
pcall(function()
    if TextChatService and TextChatService.ChatVersion == Enum.ChatVersion.TextChatService then
        local old = TextChatService.OnIncomingMessage
        TextChatService.OnIncomingMessage = function(message)
            handleCommand(message)
            if old then
                local ok, r = pcall(old, message)
                if ok then return r end
            end
            return Enum.TextChatMessageStatus.Success
        end
    end
end)

-- Path B: MessageReceived (fallback on TextChatService)
pcall(function()
    if TextChatService then
        TextChatService.MessageReceived:Connect(handleCommand)
    end
end)

-- Path C: legacy PlayerChatted (works when TextChatService isn't active)
pcall(function()
    if Players.PlayerChatted then
        Players.PlayerChatted:Connect(function(speaker, message)
            if not isWhitelisted(speaker) then return end
            -- Legacy path: synthesize a pseudo-message so handleCommand can dedupe
            local pseudo = {
                Text = message,
                TextSource = { UserId = speaker.UserId },
                MessageId = "legacy:" .. tostring(speaker.UserId) .. ":" .. tostring(message),
            }
            handleCommand(pseudo)
        end)
    end
end)

