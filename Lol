local function norm(s) return tostring(s or ""):lower():gsub("[%s%(%)%-_%[%]%./:]", "") end

-- ---------- 5.1 CommF: try canonical args, parse every shape ----------
local function parseInventoryShape(raw)
    local out = {}
    if type(raw) ~= "table" then return out end
    for k, v in pairs(raw) do
        if type(v) == "table" then
            -- Nested table: could be {Name=..., Type=..., Count=...} OR deeper folder
            if type(v.Name) == "string" and #v.Name > 1 then
                out[#out + 1] = {
                    Name = tostring(v.Name),
                    Type = tostring(v.Type or v.type or ""),
                    Count = tonumber(v.Count or v.count or v.Amount or v.amount) or 1,
                }
            else
                -- recurse one more level (folder shape)
                for k2, v2 in pairs(v) do
                    if type(v2) == "table" and type(v2.Name) == "string" and #v2.Name > 1 then
                        out[#out + 1] = {
                            Name = tostring(v2.Name),
                            Type = tostring(v2.Type or v2.type or ""),
                            Count = tonumber(v2.Count or v2.count or v2.Amount) or 1,
                        }
                    elseif type(k2) == "string" and (type(v2) == "number" or type(v2) == "string") then
                        out[#out + 1] = {
                            Name = tostring(k2),
                            Type = type(v2) == "string" and v2 or "",
                            Count = type(v2) == "number" and v2 or 1,
                        }
                    end
                end
            end
        elseif type(k) == "string" and (type(v) == "number" or type(v) == "string") then
            -- Flat dict: {["Dragon-Dragon"] = 1} or {["Dragon"] = "Blox Fruit"}
            if #k > 1 then
                out[#out + 1] = {
                    Name = tostring(k),
                    Type = type(v) == "string" and v or "",
                    Count = type(v) == "number" and v or 1,
                }
            end
        end
    end
    return out
end

local function invFromCommF()
    if not CommF then return {}, "no-CommF" end
    -- Canonical arg first. Then alternates.
    local probes = {
        { "getInventory" },
        { "GetInventory" },
        { "getFruits" },
        { "GetFruits" },
        { "getItems" },
        { "GetItems" },
    }
    for _, args in ipairs(probes) do
        local ok, raw = pcall(function() return CommF:InvokeServer(table.unpack(args)) end)
        if ok and type(raw) == "table" and next(raw) ~= nil then
            local parsed = parseInventoryShape(raw)
            if #parsed > 0 then
                lastRawInv = raw
                lastInvSource = "CommF:" .. table.concat(args, ",")
                return parsed, lastInvSource
            end
            -- Non-empty raw but nothing parsed — stash for debug
            lastRawInv = raw
            lastInvSource = "CommF-raw:" .. table.concat(args, ",")
        end
    end
    return {}, lastInvSource
end

-- ---------- 5.2 PlayerGui: extract from multiple sources per element ----------
local function extractNameFromGuiElement(d)
    -- (a) Attributes — "Name", "ItemName", "FruitName", etc.
    local okAttrs, attrs = pcall(function() return d:GetAttributes() end)
    if okAttrs and type(attrs) == "table" then
        for k, v in pairs(attrs) do
            if type(v) == "string" and #v > 2 then
                local kl = tostring(k):lower()
                if kl:find("name") or kl:find("fruit") or kl:find("item") then
                    return v, "attr:" .. kl
                end
            end
        end
    end
    -- (b) ToolTip first non-empty line
    local okTip, tip = pcall(function() return d.ToolTip end)
    if okTip and type(tip) == "string" and #tip > 2 then
        local first = tip:match("^[^\n\r]+") or tip
        first = first:gsub("^%s+", ""):gsub("%s+$", "")
        if #first > 2 and not first:lower():find("view", 1, true) then
            return first, "tooltip"
        end
    end
    -- (c) Child TextLabel
    local okKids, kids = pcall(function() return d:GetChildren() end)
    if okKids and kids then
        for _, c in ipairs(kids) do
            if c:IsA("TextLabel") and #c.Text > 2 then
                return c.Text, "childlabel"
            end
        end
    end
    -- (d) .Name if it's not a generic UI name
    local n = tostring(d.Name)
    if #n > 2 then
        local ln = n:lower()
        local generic = ln:find("frame") or ln:find("template") or ln:find("container")
            or ln:find("slot") or ln:find("grid") or ln:find("button") or ln:find("label")
            or ln:match("^%d+$")
        if not generic then return n, "name" end
    end
    return nil, nil
end

