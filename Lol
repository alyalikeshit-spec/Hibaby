local function waitForChar(timeout)
    if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then return LP.Character end
    local t0 = tick()
    while tick() - t0 < (timeout or 30) do
        if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then return LP.Character end
        task.wait(0.5)
    end
    return LP.Character
end

local function getTradeTables()
    local out = {}
    local map = workspace:FindFirstChild("Map")
    if map then
        local zoneName = (game.PlaceId == S3) and "Turtle" or "Dressrosa"
        local zone = map:FindFirstChild(zoneName)
        if zone then
            for _, c in ipairs(zone:GetChildren()) do
                if c.Name == "TradeTable" and c:FindFirstChild("P1") and c:FindFirstChild("P2") then out[#out + 1] = c end
            end
        end
    end
    if #out == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "TradeTable" and d:FindFirstChild("P1") and d:FindFirstChild("P2") then out[#out + 1] = d end
        end
    end
    return out
end

local function seatOccupant(seat)
    if not seat then return nil end
    local hum = seat.Occupant
    if hum and hum.Parent then return Players:GetPlayerFromCharacter(hum.Parent) end
    local weld = seat:FindFirstChild("SeatWeld")
    if weld and weld.Part1 and weld.Part1.Parent then
        local h = weld.Part1.Parent
        local char = h and h.Parent
        return char and Players:GetPlayerFromCharacter(char) or nil
    end
    return nil
end

local function currentSeat()
    for _, tbl in ipairs(getTradeTables()) do
        for _, s in ipairs({ tbl.P1, tbl.P2 }) do
            if seatOccupant(s) == LP then return s, tbl end
        end
    end
    return nil
end

local function oppositeSeat(seat, tbl)
    if seat == tbl.P1 then return tbl.P2 end
    if seat == tbl.P2 then return tbl.P1 end
    return nil
end

local function pickSeat(exclude)
    for _, tbl in ipairs(getTradeTables()) do
        if tbl ~= exclude then
            local o1, o2 = seatOccupant(tbl.P1), seatOccupant(tbl.P2)
            if not o1 and (not o2 or isWhitelisted(o2)) then return tbl.P1 end
            if not o2 and (not o1 or isWhitelisted(o1)) then return tbl.P2 end
        end
    end
    return nil
end

-- =============================================================================
-- 7. SIT — anchor through weld confirmation, snap on land
-- =============================================================================
local function landAndSit(seat)
    if not seat then return false end
    local char = waitForChar(10)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if currentSeat() == seat then lastSitTime = tick(); return true end

    if hum.Sit then
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        task.wait(0.2)
    end

    hum.PlatformStand = false
    hum.AutoRotate = false
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = false end
    end
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    -- ANCHOR — stays anchored all the way through weld confirm
    hrp.Anchored = true

    -- Land ON the seat (2.5 studs above seat surface), preserving seat facing
    local targetCF = seat.CFrame + Vector3.new(0, 2.5, 0)
    local dist = (hrp.Position - targetCF.Position).Magnitude
    local duration = math.clamp(dist / 200, 0.1, 0.8)

    local tw = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = targetCF }
    )
    tw:Play()
    tw.Completed:Wait()

    hrp.CFrame = targetCF
    hrp.AssemblyLinearVelocity  = Vector3.zero
    hrp.AssemblyAngularVelocity = Vector3.zero

    -- Sit request fires while anchored
    pcall(function() seat:Sit(hum) end)
    hum.Sit = true

    -- Wait for weld — the game will create one once the server processes the sit
    local welded = false
    local t0 = tick()
    while tick() - t0 < 2.5 do
        if seat.Occupant == hum or seat:FindFirstChild("SeatWeld") then
            welded = true
            break
        end
        task.wait(0.05)
    end

    -- Force weld if server slow
    if not welded then
        local weld = seat:FindFirstChild("SeatWeld")
        if not weld then
            weld = Instance.new("WeldConstraint")
            weld.Name = "SeatWeld"
            weld.Part0 = seat
            weld.Part1 = hrp
            weld.Parent = seat
        end
        welded = true
    end

    -- Unanchor ONLY after weld exists
    hrp.Anchored = false
    hum.AutoRotate = true
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
    lastSitTime = tick()
    return welded
end

local function forceJumpOff()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.3)
end

