-- 6. WAITS + SEATS
-- =============================================================================
local function waitForChar(timeout)
    if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then return LP.Character end
    local t0 = tick()
    while tick() - t0 < (timeout or 30) do
        if LP.Character and LP.Character:FindFirstChildOfClass("Humanoid") then return LP.Character end
        task.wait(0.5)
    end
    return LP.Character
end

local function getTradeTables()
    local out = {}
    local map = workspace:FindFirstChild("Map")
    if map then
        local zoneName = (game.PlaceId == S3) and "Turtle" or "Dressrosa"
        local zone = map:FindFirstChild(zoneName)
        if zone then
            for _, c in ipairs(zone:GetChildren()) do
                if c.Name == "TradeTable" and c:FindFirstChild("P1") and c:FindFirstChild("P2") then out[#out + 1] = c end
            end
        end
    end
    if #out == 0 then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d.Name == "TradeTable" and d:FindFirstChild("P1") and d:FindFirstChild("P2") then out[#out + 1] = d end
        end
    end
    return out
end

local function seatOccupant(seat)
    if not seat then return nil end
    local hum = seat.Occupant
    if hum and hum.Parent then return Players:GetPlayerFromCharacter(hum.Parent) end
    local weld = seat:FindFirstChild("SeatWeld")
    if weld and weld.Part1 and weld.Part1.Parent then
        local h = weld.Part1.Parent
        local char = h and h.Parent
        return char and Players:GetPlayerFromCharacter(char) or nil
    end
    return nil
end

local function currentSeat()
    for _, tbl in ipairs(getTradeTables()) do
        for _, s in ipairs({ tbl.P1, tbl.P2 }) do
            if seatOccupant(s) == LP then return s, tbl end
        end
    end
    return nil
end

local function oppositeSeat(seat, tbl)
    if seat == tbl.P1 then return tbl.P2 end
    if seat == tbl.P2 then return tbl.P1 end
    return nil
end

local function pickSeat(exclude)
    local tables = getTradeTables()
    for _, tbl in ipairs(tables) do
        if tbl ~= exclude then
            local o1, o2 = seatOccupant(tbl.P1), seatOccupant(tbl.P2)
            if not o1 and (not o2 or isWhitelisted(o2)) then return tbl.P1 end
            if not o2 and (not o1 or isWhitelisted(o1)) then return tbl.P2 end
        end
    end
    return nil
end

-- =============================================================================
-- 7. STABLE SIT
-- =============================================================================
local function stabilizeCharacter(char)
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then
            p.CanCollide = false
            p.AssemblyLinearVelocity  = Vector3.zero
            p.AssemblyAngularVelocity = Vector3.zero
        end
    end
    hum.PlatformStand = false
    hum.AutoRotate = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
end

local function restoreCharacter(char)
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if hum then hum.AutoRotate = true end
    for _, p in ipairs(char:GetDescendants()) do
        if p:IsA("BasePart") then p.CanCollide = true end
    end
end

local function smoothTeleport(seat)
    local char = waitForChar(10)
    if not char then return false end
    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hrp or not hum then return false end

    if hum.Sit then
        hum.Sit = false
        pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
        task.wait(0.25)
    end

    stabilizeCharacter(char)

    local seatCF = seat.CFrame
    local targetPos = seat.Position + Vector3.new(0, 3.2, 0)
    local dist = (hrp.Position - targetPos).Magnitude
    local duration = math.clamp(dist / 120, 0.15, 1.2)

    local wasAnchored = hrp.Anchored
    hrp.Anchored = true

    local tw = TweenService:Create(
        hrp,
        TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
        { CFrame = CFrame.new(targetPos) * (seatCF - seatCF.Position) }
    )
    tw:Play()
    tw.Completed:Wait()

    hrp.CFrame = CFrame.new(targetPos) * (seatCF - seatCF.Position)
    hrp.Anchored = wasAnchored
    hum.AutoRotate = true
    task.wait(0.05)
    return true
end

local function forceSeat(char, seat)
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    pcall(function() seat:Sit(hum) end)
    hum.Sit = true

    local t0 = tick()
    while tick() - t0 < 3 do
        if seat:FindFirstChild("SeatWeld") and seat.Occupant == hum then return true end
        if seatOccupant(seat) == LP then return true end
        task.wait(0.05)
    end

    local hrp = char:FindFirstChild("HumanoidRootPart") or char.PrimaryPart
    if hrp and seat:IsA("BasePart") then
        local weld = seat:FindFirstChild("SeatWeld")
        if not weld then
            weld = Instance.new("WeldConstraint")
            weld.Name = "SeatWeld"
            weld.Part0 = seat
            weld.Part1 = hrp
            weld.Parent = seat
        end
        hrp.CFrame = seat.CFrame * CFrame.new(0, 1.5, 0)
        hum.Sit = true
        return true
    end
    return false
end

local function sitOn(seat)
    if not seat then return false end
    if currentSeat() == seat then lastSitTime = tick() return true end

    local char = LP.Character
    if char then
        local hum = char:FindFirstChildOfClass("Humanoid")
        if hum and hum.Sit and tick() - lastSitTime < 5 then return true end
    end

    if not smoothTeleport(seat) then return false end
    char = waitForChar(5)
    if not char then return false end

    local ok = forceSeat(char, seat)
    restoreCharacter(char)
    lastSitTime = tick()
    return ok
end

local function forceJumpOff()
    local char = LP.Character
    if not char then return end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum then return end
    hum.Sit = false
    pcall(function() hum:ChangeState(Enum.HumanoidStateType.Jumping) end)
    task.wait(0.3)
end

